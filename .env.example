# ══════════════════════════════════════════════════════════════════════════════
#  VoiceOps_Engine — Environment Variables Template
#  Copy this file to `.env` and fill in your actual values.
#  ⚠️  Never commit your real .env file to version control.
# ══════════════════════════════════════════════════════════════════════════════

# ── VAPI Configuration ─────────────────────────────────────────────────────────
# Your VAPI account-level API key (https://dashboard.vapi.ai → API Keys)
VAPI_API_KEY=your_vapi_api_key_here

# The ID of the VAPI assistant to use for calls
VAPI_ASSISTANT_ID=your_vapi_assistant_id_here

# The VAPI phone number resource ID to originate outbound calls from
VAPI_PHONE_NUMBER_ID=your_vapi_phone_number_id_here

# ── Google Gemini Configuration ────────────────────────────────────────────────
# Google AI Studio API key (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# ── Groq Configuration (Fallback LLM) ──────────────────────────────────────────
# Groq API key for ultra-fast LLM inference (https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# ── n8n Webhook URLs ───────────────────────────────────────────────────────────
# Webhook triggered during an active call (mid-call tool / function calling)
N8N_MIDCALL_WEBHOOK_URL=http://localhost:5678/webhook/midcall

# Webhook triggered after a call ends (post-call processing / CRM sync)
N8N_POSTCALL_WEBHOOK_URL=http://localhost:5678/webhook/postcall

# ── Third-Party Notification & CRM Integration Targets ─────────────────────────
# Slack Incoming Webhook URL for real-time lead escalation alerts
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK_URL

# Google Sheet Document ID for CRM call logging
GOOGLE_SHEET_ID=your_google_sheet_id_here

# ── Application Settings (optional overrides) ──────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
