{
  "name": "VoiceOps — Post-Call Intelligence & CRM Sync",
  "nodes": [
    {
      "id": "b2c3d4e5-0002-0002-0002-000000000001",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 400],
      "webhookId": "voiceops-postcall",
      "parameters": {
        "httpMethod": "POST",
        "path": "postcall",
        "responseMode": "responseNode",
        "options": {}
      }
    },
    {
      "id": "b2c3d4e5-0002-0002-0002-000000000002",
      "name": "Parse Enriched Payload",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [480, 400],
      "parameters": {
        "mode": "manual",
        "duplicateItem": false,
        "assignments": {
          "assignments": [
            {
              "id": "pf-001",
              "name": "phone_number",
              "value": "={{ $json.body.phone_number ?? '' }}",
              "type": "string"
            },
            {
              "id": "pf-002",
              "name": "classification",
              "value": "={{ $json.body.classification ?? 'Unknown' }}",
              "type": "string"
            },
            {
              "id": "pf-003",
              "name": "budget_mentioned",
              "value": "={{ $json.body.budget_mentioned ?? false }}",
              "type": "boolean"
            },
            {
              "id": "pf-004",
              "name": "timeline",
              "value": "={{ $json.body.timeline ?? '' }}",
              "type": "string"
            },
            {
              "id": "pf-005",
              "name": "intent_reasoning",
              "value": "={{ $json.body.intent_reasoning ?? '' }}",
              "type": "string"
            },
            {
              "id": "pf-006",
              "name": "key_pain_points",
              "value": "={{ ($json.body.key_pain_points ?? []).join(', ') }}",
              "type": "string"
            },
            {
              "id": "pf-007",
              "name": "duration_minutes",
              "value": "={{ $json.body.duration_minutes ?? 0 }}",
              "type": "number"
            },
            {
              "id": "pf-008",
              "name": "recording_url",
              "value": "={{ $json.body.recording_url ?? '' }}",
              "type": "string"
            },
            {
              "id": "pf-009",
              "name": "timestamp",
              "value": "={{ new Date().toISOString() }}",
              "type": "string"
            },
            {
              "id": "pf-010",
              "name": "emoji",
              "value": "={{ $json.body.classification === 'Hot' ? '🔥' : $json.body.classification === 'Warm' ? '⚡' : '❄️' }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "b2c3d4e5-0002-0002-0002-000000000003",
      "name": "Route by Classification",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [720, 400],
      "parameters": {
        "mode": "rules",
        "rules": {
          "rules": [
            {
              "conditions": {
                "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
                "conditions": [
                  {
                    "leftValue": "={{ $json.classification }}",
                    "rightValue": "Hot",
                    "operator": { "type": "string", "operation": "equals" }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "Hot"
            },
            {
              "conditions": {
                "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
                "conditions": [
                  {
                    "leftValue": "={{ $json.classification }}",
                    "rightValue": "Warm",
                    "operator": { "type": "string", "operation": "equals" }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "Warm"
            },
            {
              "conditions": {
                "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
                "conditions": [
                  {
                    "leftValue": "={{ $json.classification }}",
                    "rightValue": "Cold",
                    "operator": { "type": "string", "operation": "equals" }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "Cold"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "b2c3d4e5-0002-0002-0002-000000000004",
      "name": "🔥 Slack Alert — Hot Lead",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [980, 200],
      "parameters": {
        "method": "POST",
        "url": "https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK_URL",
        "sendBody": true,
        "contentType": "json",
        "bodyParameters": {
          "parameters": [
            {
              "name": "text",
              "value": "=🔥 *HOT LEAD — Immediate Follow-Up Required!*\n>*Phone:* `{{ $('Parse Enriched Payload').item.json.phone_number }}`\n>*Budget Mentioned:* {{ $('Parse Enriched Payload').item.json.budget_mentioned ? '✅ Yes' : '❌ No' }}\n>*Timeline:* {{ $('Parse Enriched Payload').item.json.timeline }}\n>*Pain Points:* {{ $('Parse Enriched Payload').item.json.key_pain_points }}\n>*Reasoning:* {{ $('Parse Enriched Payload').item.json.intent_reasoning }}\n>*Duration:* {{ $('Parse Enriched Payload').item.json.duration_minutes }} min\n>*Recording:* {{ $('Parse Enriched Payload').item.json.recording_url }}"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      }
    },
    {
      "id": "b2c3d4e5-0002-0002-0002-000000000005",
      "name": "⚡ Slack Alert — Warm Lead",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [980, 400],
      "parameters": {
        "method": "POST",
        "url": "https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK_URL",
        "sendBody": true,
        "contentType": "json",
        "bodyParameters": {
          "parameters": [
            {
              "name": "text",
              "value": "=⚡ *WARM LEAD — Schedule a Follow-Up*\n>*Phone:* `{{ $('Parse Enriched Payload').item.json.phone_number }}`\n>*Budget Mentioned:* {{ $('Parse Enriched Payload').item.json.budget_mentioned ? '✅ Yes' : '❌ No' }}\n>*Timeline:* {{ $('Parse Enriched Payload').item.json.timeline }}\n>*Pain Points:* {{ $('Parse Enriched Payload').item.json.key_pain_points }}\n>*Reasoning:* {{ $('Parse Enriched Payload').item.json.intent_reasoning }}\n>*Duration:* {{ $('Parse Enriched Payload').item.json.duration_minutes }} min"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      }
    },
    {
      "id": "b2c3d4e5-0002-0002-0002-000000000006",
      "name": "❄️ Slack Alert — Cold Lead",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [980, 600],
      "parameters": {
        "method": "POST",
        "url": "https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK_URL",
        "sendBody": true,
        "contentType": "json",
        "bodyParameters": {
          "parameters": [
            {
              "name": "text",
              "value": "=❄️ *Cold Lead — Add to nurture sequence*\n>*Phone:* `{{ $('Parse Enriched Payload').item.json.phone_number }}`\n>*Reasoning:* {{ $('Parse Enriched Payload').item.json.intent_reasoning }}\n>*Duration:* {{ $('Parse Enriched Payload').item.json.duration_minutes }} min"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      }
    },
    {
      "id": "b2c3d4e5-0002-0002-0002-000000000007",
      "name": "Save to Google Sheets",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [1220, 400],
      "continueOnFail": true,
      "parameters": {
        "resource": "sheet",
        "operation": "appendOrUpdate",
        "documentId": {
          "__rl": true,
          "value": "YOUR_GOOGLE_SHEET_ID_HERE",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Calls",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Timestamp":        "={{ $('Parse Enriched Payload').item.json.timestamp }}",
            "Phone Number":     "={{ $('Parse Enriched Payload').item.json.phone_number }}",
            "Classification":   "={{ $('Parse Enriched Payload').item.json.classification }}",
            "Budget Mentioned": "={{ $('Parse Enriched Payload').item.json.budget_mentioned }}",
            "Timeline":         "={{ $('Parse Enriched Payload').item.json.timeline }}",
            "Key Pain Points":  "={{ $('Parse Enriched Payload').item.json.key_pain_points }}",
            "Intent Reasoning": "={{ $('Parse Enriched Payload').item.json.intent_reasoning }}",
            "Duration (min)":   "={{ $('Parse Enriched Payload').item.json.duration_minutes }}",
            "Recording URL":    "={{ $('Parse Enriched Payload').item.json.recording_url }}"
          },
          "matchingColumns": ["Phone Number"],
          "schema": []
        },
        "options": {}
      }
    },
    {
      "id": "b2c3d4e5-0002-0002-0002-000000000008",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1460, 400],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ \"status\": \"ok\", \"classification\": $('Parse Enriched Payload').item.json.classification }) }}",
        "options": {
          "responseCode": 200
        }
      }
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [
        [
          { "node": "Parse Enriched Payload", "type": "main", "index": 0 }
        ]
      ]
    },
    "Parse Enriched Payload": {
      "main": [
        [
          { "node": "Route by Classification", "type": "main", "index": 0 },
          { "node": "Save to Google Sheets", "type": "main", "index": 0 }
        ]
      ]
    },
    "Route by Classification": {
      "main": [
        [
          { "node": "🔥 Slack Alert — Hot Lead", "type": "main", "index": 0 }
        ],
        [
          { "node": "⚡ Slack Alert — Warm Lead", "type": "main", "index": 0 }
        ],
        [
          { "node": "❄️ Slack Alert — Cold Lead", "type": "main", "index": 0 }
        ]
      ]
    },
    "🔥 Slack Alert — Hot Lead": {
      "main": [
        [
          { "node": "Respond to Webhook", "type": "main", "index": 0 }
        ]
      ]
    },
    "⚡ Slack Alert — Warm Lead": {
      "main": [
        [
          { "node": "Respond to Webhook", "type": "main", "index": 0 }
        ]
      ]
    },
    "❄️ Slack Alert — Cold Lead": {
      "main": [
        [
          { "node": "Respond to Webhook", "type": "main", "index": 0 }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true,
    "callerPolicy": "workflowsFromSameOwner",
    "errorWorkflow": ""
  },
  "meta": {
    "templateCredsSetupCompleted": false,
    "instanceId": "voiceops"
  },
  "tags": [
    { "name": "voiceops" },
    { "name": "post-call" }
  ],
  "notes": "SETUP REQUIRED:\n1. Replace YOUR_SLACK_WEBHOOK_URL with your Slack Incoming Webhook URL.\n2. Replace YOUR_GOOGLE_SHEET_ID_HERE with your Google Sheet ID (from the spreadsheet URL).\n3. Connect your Google Service Account or OAuth credential to the Save to Google Sheets node.\n4. Create a sheet tab named 'Calls' with headers: Timestamp | Phone Number | Classification | Budget Mentioned | Timeline | Key Pain Points | Intent Reasoning | Duration (min) | Recording URL\n5. Activate the workflow and copy the Webhook URL into your FastAPI .env as N8N_POSTCALL_WEBHOOK_URL."
}
